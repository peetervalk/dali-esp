# ESP32-DevKitC-VE / ESP32-WROVER-E pre-hardware defaults.

# WROVER-E module flash size.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# Prefer maximum ESP32 CPU frequency for ISR margin during PHY bring-up.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# Keep 1 ms task delays to at least one FreeRTOS tick.
CONFIG_FREERTOS_HZ=1000

# Keep ISR-adjacent GPIO/GPTIMER paths in IRAM where ESP-IDF exposes options.
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y
CONFIG_GPTIMER_ISR_HANDLER_IN_IRAM=y
CONFIG_GPTIMER_CTRL_FUNC_IN_IRAM=y
CONFIG_GPTIMER_ISR_CACHE_SAFE=y
CONFIG_FREERTOS_IN_IRAM=y
